# ---------- App ----------
APP_ENV=local                 # local | staging | prod
LOG_LEVEL=INFO
EVAL_MODE=false               # enables /v1/evals/* endpoints; never true in prod
DEV_AUTH=true                 # local fixed user; false once GitHub OAuth is on (M7)
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---------- Data ----------
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
BLOB_BACKEND=local            # local | azure
BLOB_LOCAL_DIR=./.data/blobs
AZURE_STORAGE_CONNECTION_STRING=

# ---------- LLM providers ----------
# Primary provider is Groq (OpenAI GPT-OSS open-weight models). Gemini is kept
# as an option but is not wired into the live app; set GROQ_API_KEY to use Groq.
GROQ_API_KEY=
GEMINI_API_KEY=              # optional; not used by the live app by default
MODAL_VLLM_BASE_URL=          # M8: OpenAI-compatible endpoint for small models
MODAL_VLLM_API_KEY=

# Model aliases (LiteLLM model strings). Groq model ids available vary by account;
# list them with GET https://api.groq.com/openai/v1/models.
LLM_FAST_MODEL=groq/openai/gpt-oss-20b
LLM_FAST_FALLBACKS=           # comma-separated
LLM_STRONG_MODEL=groq/openai/gpt-oss-120b
LLM_STRONG_FALLBACKS=
LLM_JUDGE_MODEL=groq/openai/gpt-oss-120b   # pinned per judge version
LLM_FOLLOWUP_MODEL=
LLM_GENERATOR_MODEL=

LLM_TIMEOUT_FAST_S=4
LLM_TIMEOUT_STRONG_S=20
LLM_TIMEOUT_JUDGE_S=30
LLM_MAX_RETRIES=2

# ---------- Embeddings / retrieval ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVE_TOP_K=30
RERANK_TOP_N=6
ABSTAIN_THRESHOLD=0.0         # tuned on the golden set in M1-T7
KB_VERSION=1

# ---------- Observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Voice (M5) ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-IN-NeerjaNeural

# ---------- Auth (M7) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=change-me
JWT_TTL_HOURS=168

# ---------- Budgets and quotas ----------
BUDGET_USD_PER_USER_DAY=0.50
BUDGET_USD_GLOBAL_DAY=3.00
BUDGET_USD_PER_EVAL_RUN=1.00
QUOTA_VOICE_MINUTES_PER_USER_DAY=30
RATE_LIMIT_PER_MIN=30
